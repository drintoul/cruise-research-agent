# ============================================================
# Chainlit
# ============================================================

CHAINLIT_PORT=8000


# ============================================================
# Ollama
# ============================================================

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=16384

EMBEDDING_MODEL=nomic-embed-text


# ============================================================
# Qdrant
# ============================================================

QDRANT_URL=http://qdrant:6333
QDRANT_IMAGE=qdrant/qdrant:v1.19.0
QDRANT_COLLECTION=travel_knowledge

RAG_TOP_K=8


# ============================================================
# SearXNG
# ============================================================

SEARXNG_BASE_URL=http://host.docker.internal:8088
SEARXNG_TIMEOUT_SECONDS=20
SEARXNG_MAX_RESULTS=10


# ============================================================
# Firecrawl
# ============================================================

FIRECRAWL_BASE_URL=http://host.docker.internal:3002
FIRECRAWL_API_KEY=
FIRECRAWL_TIMEOUT_SECONDS=60
FIRECRAWL_CRAWL_TIMEOUT_SECONDS=300


# ============================================================
# Agent
# ============================================================

MAX_AGENT_LLM_CALLS=8
MAX_SEARCH_RESULTS=10
MAX_CRAWL_PAGES=10
MAX_CRAWL_DEPTH=2
MAX_TOOL_OUTPUT_CHARS=50000


# ============================================================
# Document ingestion
# ============================================================

DOCUMENTS_DIR=/app/documents

INGEST_SCAN_INTERVAL_SECONDS=300
INGEST_HEARTBEAT_FILE=/tmp/document-ingester-heartbeat
INGEST_HEALTH_MAX_AGE_SECONDS=660

DOCUMENT_CHUNK_SIZE=2200
DOCUMENT_CHUNK_OVERLAP=250

LOG_LEVEL=INFO


# ============================================================
# Cloudflare Tunnel 
# ============================================================

# Cloudflare Tunnel token (from your Cloudflare Zero Trust dashboard)   
CLOUDFLARE_TUNNEL_TOKEN=<insert_token_here>
